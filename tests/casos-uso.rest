### Casos de Uso - Sistema de Gestión de Médicos
### Este archivo contiene pruebas para escenarios de uso real

# ========================================
# CASO DE USO 1: NUEVO PACIENTE Y PRIMERA CITA
# ========================================

### 1.1 Login del médico
# @name loginMedico
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "dr.garcia@ejemplo.com",
  "password": "password123"
}

### 1.2 Registrar nuevo paciente
# @name nuevoPaciente
POST {{baseUrl}}/api/pacientes
Authorization: Bearer {{loginMedico.response.body.data.token}}
Content-Type: application/json

{
  "nombre": "Laura",
  "apellido": "Fernández",
  "email": "laura.fernandez@email.com",
  "telefono": "+52 55 3333 4444",
  "fechaNacimiento": "1988-12-03",
  "genero": "femenino",
  "direccion": "Av. Universidad 123, CDMX",
  "historialMedico": "Primera consulta, sin antecedentes conocidos",
  "alergias": "Ninguna conocida"
}

### 1.3 Programar primera cita
# @name primeraCita
POST {{baseUrl}}/api/citas
Authorization: Bearer {{loginMedico.response.body.data.token}}
Content-Type: application/json

{
  "fecha": "2024-12-25",
  "hora": "10:00",
  "duracion": 60,
  "motivo": "Primera consulta - Chequeo general",
  "estado": "programada",
  "notas": "Paciente nueva, realizar examen físico completo y análisis de sangre",
  "pacienteId": "{{nuevoPaciente.response.body.data.id}}"
}

### 1.4 Enviar recordatorio (simulado)
GET {{baseUrl}}/api/citas/proximas
Authorization: Bearer {{loginMedico.response.body.data.token}}

# ========================================
# CASO DE USO 2: CONSULTA MÉDICA COMPLETA
# ========================================

### 2.1 Actualizar estado de cita a confirmada
PUT {{baseUrl}}/api/citas/{{primeraCita.response.body.data.id}}
Authorization: Bearer {{loginMedico.response.body.data.token}}
Content-Type: application/json

{
  "fecha": "2024-12-25",
  "hora": "10:00",
  "duracion": 60,
  "motivo": "Primera consulta - Chequeo general",
  "estado": "confirmada",
  "notas": "Paciente confirmó asistencia. Preparar para examen físico completo.",
  "pacienteId": "{{nuevoPaciente.response.body.data.id}}"
}

### 2.2 Registrar ingreso por consulta
# @name ingresoConsulta
POST {{baseUrl}}/api/ingresos
Authorization: Bearer {{loginMedico.response.body.data.token}}
Content-Type: application/json

{
  "descripcion": "Primera consulta - Laura Fernández",
  "monto": 1500.00,
  "categoria": "consulta",
  "fecha": "2024-12-25",
  "metodoPago": "efectivo",
  "pacienteId": "{{nuevoPaciente.response.body.data.id}}",
  "citaId": "{{primeraCita.response.body.data.id}}"
}

### 2.3 Crear receta médica
# @name recetaMedica
POST {{baseUrl}}/api/recetas
Authorization: Bearer {{loginMedico.response.body.data.token}}
Content-Type: application/json

{
  "diagnostico": "Hipertensión arterial leve",
  "medicamentos": "Losartán 25mg - 1 tableta diaria en la mañana\nAmlodipino 2.5mg - 1 tableta diaria en la mañana",
  "indicaciones": "Tomar con el desayuno. Controlar presión arterial 3 veces por semana.",
  "observaciones": "Mantener dieta baja en sodio, ejercicio regular 30 min diarios. Evitar alcohol y tabaco.",
  "proximaCita": "2025-01-25T10:00:00.000Z",
  "pacienteId": "{{nuevoPaciente.response.body.data.id}}"
}

### 2.4 Marcar cita como completada
PUT {{baseUrl}}/api/citas/{{primeraCita.response.body.data.id}}
Authorization: Bearer {{loginMedico.response.body.data.token}}
Content-Type: application/json

{
  "fecha": "2024-12-25",
  "hora": "10:00",
  "duracion": 60,
  "motivo": "Primera consulta - Chequeo general",
  "estado": "completada",
  "notas": "Consulta completada. Paciente diagnosticada con hipertensión leve. Receta entregada.",
  "pacienteId": "{{nuevoPaciente.response.body.data.id}}"
}

### 2.5 Descargar receta en PDF
GET {{baseUrl}}/api/recetas/{{recetaMedica.response.body.data.id}}/pdf
Authorization: Bearer {{loginMedico.response.body.data.token}}

