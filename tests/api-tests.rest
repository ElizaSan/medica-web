### Sistema de Gestión de Médicos - Pruebas de API
### Base URL: http://localhost:3000

# ========================================
# VARIABLES GLOBALES
# ========================================
@baseUrl = http://localhost:3000
@authToken = {{login.response.body.data.token}}
@userId = {{login.response.body.data.usuario.id}}

# ========================================
# 1. AUTENTICACIÓN
# ========================================

### Registro de nuevo médico
# @name registro
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "email": "dr.nuevo@ejemplo.com",
  "password": "password123",
  "nombre": "Ana",
  "apellido": "Martínez",
  "especialidad": "Cardiología",
  "telefono": "+52 55 9999 8888",
  "direccion": "Av. Insurgentes 500, CDMX",
  "fechaNacimiento": "1980-05-20"
}

### Login con médico existente
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "dr.garcia@ejemplo.com",
  "password": "password123"
}

### Verificar token
GET {{baseUrl}}/api/auth/verificar
Authorization: Bearer {{authToken}}

# ========================================
# 2. GESTIÓN DE USUARIOS
# ========================================

### Obtener perfil del usuario
GET {{baseUrl}}/api/usuarios/perfil
Authorization: Bearer {{authToken}}

### Actualizar perfil
PUT {{baseUrl}}/api/usuarios/perfil
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "nombre": "Carlos",
  "apellido": "García",
  "especialidad": "Medicina General",
  "telefono": "+52 55 1234 5678",
  "direccion": "Av. Reforma 123, Ciudad de México",
  "fechaNacimiento": "1985-03-15"
}

### Cambiar contraseña
PUT {{baseUrl}}/api/usuarios/cambiar-password
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "passwordActual": "password123",
  "passwordNuevo": "nuevaPassword456"
}

### Obtener estadísticas del usuario
GET {{baseUrl}}/api/usuarios/estadisticas
Authorization: Bearer {{authToken}}

# ========================================
# 3. GESTIÓN DE PACIENTES
# ========================================

### Listar todos los pacientes
GET {{baseUrl}}/api/pacientes?page=1&limit=10
Authorization: Bearer {{authToken}}

### Buscar pacientes
GET {{baseUrl}}/api/pacientes?search=maria
Authorization: Bearer {{authToken}}

### Crear nuevo paciente
# @name crearPaciente
POST {{baseUrl}}/api/pacientes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "nombre": "Pedro",
  "apellido": "Sánchez",
  "email": "pedro.sanchez@email.com",
  "telefono": "+52 55 1111 2222",
  "fechaNacimiento": "1992-08-15",
  "genero": "masculino",
  "direccion": "Calle Morelos 789, CDMX",
  "historialMedico": "Salud general buena, sin antecedentes importantes",
  "alergias": "Ninguna conocida"
}

### Obtener paciente por ID
GET {{baseUrl}}/api/pacientes/{{crearPaciente.response.body.data.id}}
Authorization: Bearer {{authToken}}

### Actualizar paciente
PUT {{baseUrl}}/api/pacientes/{{crearPaciente.response.body.data.id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "nombre": "Pedro",
  "apellido": "Sánchez",
  "email": "pedro.sanchez@email.com",
  "telefono": "+52 55 1111 2222",
  "fechaNacimiento": "1992-08-15",
  "genero": "masculino",
  "direccion": "Calle Morelos 789, CDMX",
  "historialMedico": "Salud general buena, sin antecedentes importantes. Control de presión arterial.",
  "alergias": "Ninguna conocida"
}

### Obtener estadísticas de pacientes
GET {{baseUrl}}/api/pacientes/estadisticas/resumen
Authorization: Bearer {{authToken}}

# ========================================
# 4. GESTIÓN DE CITAS
# ========================================

### Listar todas las citas
GET {{baseUrl}}/api/citas?page=1&limit=10
Authorization: Bearer {{authToken}}

### Filtrar citas por estado
GET {{baseUrl}}/api/citas?estado=programada
Authorization: Bearer {{authToken}}

### Filtrar citas por fecha
GET {{baseUrl}}/api/citas?fechaInicio=2024-01-01&fechaFin=2024-12-31
Authorization: Bearer {{authToken}}

### Crear nueva cita
# @name crearCita
POST {{baseUrl}}/api/citas
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "fecha": "2024-12-20",
  "hora": "15:00",
  "duracion": 45,
  "motivo": "Control de diabetes",
  "estado": "programada",
  "notas": "Revisar niveles de glucosa y ajustar medicación",
  "pacienteId": "{{crearPaciente.response.body.data.id}}"
}

### Obtener cita por ID
GET {{baseUrl}}/api/citas/{{crearCita.response.body.data.id}}
Authorization: Bearer {{authToken}}

### Actualizar cita
PUT {{baseUrl}}/api/citas/{{crearCita.response.body.data.id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "fecha": "2024-12-20",
  "hora": "16:00",
  "duracion": 60,
  "motivo": "Control de diabetes",
  "estado": "confirmada",
  "notas": "Revisar niveles de glucosa y ajustar medicación. Paciente confirmó asistencia."
}

### Obtener citas para calendario
GET {{baseUrl}}/api/citas/calendario?mes=12&año=2024
Authorization: Bearer {{authToken}}

### Obtener próximas citas
GET {{baseUrl}}/api/citas/proximas
Authorization: Bearer {{authToken}}

### Obtener estadísticas de citas
GET {{baseUrl}}/api/citas/estadisticas/resumen
Authorization: Bearer {{authToken}}

