# ========================================
# 7. GESTIÓN DE RECETAS
# ========================================

### Listar todas las recetas
GET {{baseUrl}}/api/recetas?page=1&limit=10
Authorization: Bearer {{authToken}}

### Filtrar recetas por paciente
GET {{baseUrl}}/api/recetas?pacienteId={{crearPaciente.response.body.data.id}}
Authorization: Bearer {{authToken}}

### Crear nueva receta
# @name crearReceta
POST {{baseUrl}}/api/recetas
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "diagnostico": "Diabetes mellitus tipo 2",
  "medicamentos": "Metformina 500mg - 2 tabletas con cada comida\nGlimepirida 1mg - 1 tableta en la mañana",
  "indicaciones": "Tomar con las comidas. Monitorear glucosa en ayunas.",
  "observaciones": "Continuar con dieta y ejercicio. Evitar azúcares simples.",
  "proximaCita": "2025-01-15T10:00:00.000Z",
  "pacienteId": "{{crearPaciente.response.body.data.id}}"
}

### Obtener receta por ID
GET {{baseUrl}}/api/recetas/{{crearReceta.response.body.data.id}}
Authorization: Bearer {{authToken}}

### Actualizar receta
PUT {{baseUrl}}/api/recetas/{{crearReceta.response.body.data.id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "diagnostico": "Diabetes mellitus tipo 2 controlada",
  "medicamentos": "Metformina 500mg - 2 tabletas con cada comida\nGlimepirida 1mg - 1 tableta en la mañana",
  "indicaciones": "Tomar con las comidas. Monitorear glucosa en ayunas. Controlar peso semanalmente.",
  "observaciones": "Continuar con dieta y ejercicio. Evitar azúcares simples. Mejorar control glucémico.",
  "proximaCita": "2025-01-15T10:00:00.000Z",
